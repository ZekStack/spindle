{
  "name": "spindle",
  "version": "0.1.0",
  "description": "A desktop workspace for repositories, releases and workflows.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/generate-icons.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:dir": "pnpm build && electron-builder --dir --publish never",
    "pack:linux": "pnpm build && electron-builder --linux AppImage deb --x64 --publish never",
    "pack:win": "pnpm build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.10.10",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "tailwind-merge": "^3.7.0",
    "electron-updater": "6.8.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "desktopName": "dev.zekstack.spindle.desktop"
}
